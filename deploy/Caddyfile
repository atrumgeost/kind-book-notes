# Serves the built static site. No domain here on purpose: Coolify's proxy
# routes whatever domain you configure to this container on port 80.
{
	# HTTPS is handled in front of us (Coolify + Cloudflare).
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip
	file_server

	# Vite puts a content hash in every asset file name, so these can be cached forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, theme-init.js) must be checked on every visit,
	# so a new deploy shows up right away.
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	header {
		# connect-src 'none' makes the privacy promise enforceable: the page cannot
		# send anything anywhere, even if a bug or a dependency tried to.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
}
